-- Полный скрипт на нормализацию БД
-- 1. Нормализация таблицы company
-- 1.1
create table country (
	id_country serial primary key,
	name text not null
);
-- 1.2
update company set country = 'Russia' where country like 'Russia%';
-- 1.3
insert into country (name) 
	select distinct country from company;
-- 1.4
alter table company add column id_country int;
-- 1.5
select 'update company set id_country = '||id_country::text ||
	' where country='''||name||''';'
from country;
-- нужно выполнить запросы, сфомированные запросом 1.5
-- 1.6
alter table company drop column country;
-- 1.7
alter table company alter column id_country set not null;
-- 1.8
alter table company
	add foreign key (id_country) references country(id_country);


-- Нормализация таблицы passenger
-- 2.1
alter table passenger add column lname text;
-- 2.2
update passenger set 
	lname = split_part(name, ' ', -1), 
	name = trim(split_part(name, split_part(name, ' ', -1), 1));
-- 2.3
alter table passenger 
	alter column name set not null,
	alter column lname set not null, 
	add check (sex in ('f','m'));

-- Нормализация таблицы pass_in_trip
-- 3.1
alter table pass_in_trip alter column date type date;

-- Нормализация таблицы trip
-- 4.1
alter table trip 
	alter column time_out type time,
	alter column time_in type time;
-- 4.2
create table trip_days (
	trip_no int not null,
	day int not null,
	primary key (trip_no, day)
);
-- 4.3
insert into trip_days
	select trip_no, string_to_table::int
	from trip, string_to_table(days, ',');
-- 4.4
alter table trip drop column days;
-- 4.5
alter table trip_days
	add foreign key (trip_no) references trip(trip_no) on delete cascade;

-- 4.6
create table towns(
	id_town serial primary key,
	name text not null
);
-- 4.7
insert into towns (name)
	select town_to from trip
	union 
	select town_from from trip;
-- 4.8
alter table trip 
	add column id_town_from integer,
	add column id_town_to integer;
-- 4.9
select 'update trip set id_town_from = '||id_town::text ||' where town_from='''||name||''';'
from towns
union
select 'update trip set id_town_to = '||id_town::text ||' where town_to='''||name||''';'
from towns;
-- 4.10 - выполнить запросы, сформированные запросом 4.9
-- 4.11
alter table trip drop column town_to, drop column town_from;
-- 4.12
alter table trip
	add foreign key (id_town_from) references towns(id_town),
	add foreign key (id_town_to) references towns(id_town);



-- 4.13
create table planes(
	id_plane serial primary key,
	name text not null
);
-- 4.14
insert into planes (name)
	select distinct plane from trip;
-- 4.15
alter table trip 
	add column id_plane integer;
-- 4.16
select 'update trip set id_plane = '||id_plane::text ||' where plane='''||name||''';'
from planes;
-- 4.17 - выполнить запросы, сформированные запросом 4.16
-- 4.18
alter table trip drop column plane;
-- 4.18
alter table trip
	add foreign key (id_plane) references planes(id_plane);
